; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="低多边形类魂合作沙盒 Demo"
config/description="类魂战斗 + 四人合作 + 可破坏地形的玩法验证 Demo"
run/main_scene="res://scenes/levels/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

InputSetup="*res://scripts/core/input_setup.gd"
EventBus="*res://scripts/core/event_bus.gd"
GameConfig="*res://scripts/core/game_config.gd"
GameState="*res://scripts/core/game_state.gd"
AudioManager="*res://scripts/core/audio_manager.gd"
AudioFeedback="*res://scripts/core/audio_feedback.gd"
DebrisPool="*res://scripts/terrain/debris_pool.gd"
TerrainManager="*res://scripts/terrain/terrain_manager.gd"
NetManager="*res://scripts/net/net_manager.gd"
DebugHud="*res://scripts/ui/debug_hud.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="低多边形类魂合作沙盒 Demo"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player_body"
3d_physics/layer_3="enemy_body"
3d_physics/layer_4="player_attack"
3d_physics/layer_5="enemy_attack"
3d_physics/layer_6="destructible"
3d_physics/layer_7="interactable"

[physics]

3d/default_gravity=26.0

[rendering]

anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.11, 0.12, 0.15, 1)
anti_aliasing/quality/screen_space_aa=1
